      "parameters": {
        "promptType": "define",
        "text": "={{ $json.message.text.body }}",
        "options": {
          "systemMessage": "You are a helpful calendar assistant that manages appointments via WhatsApp. You have access to the following tools:\n\n- Get Calendar Events: Retrieve events from the user's Google Calendar within a specified time range\n- Create Calendar Event: Add new events to the calendar\n- Update Calendar Event: Modify existing calendar events\n- Delete Calendar Event: Remove events from the calendar\n\nWhen users ask about their schedule, use the Get Calendar Events tool with appropriate time ranges. For \"today\", use the current date. For \"this week\", use the current week range. Always provide clear, friendly responses about their appointments including event titles, times, and locations. When creating or updating events, confirm the details with the user.",
          "maxIterations": 10
        }
      },
      "id": "db4f6e40-a18b-4e4a-bb37-51ec0c6cfd5f",
      "name": "Calendar Assistant",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        712,
        304
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "builtInTools": {},
        "options": {}
      },
      "id": "e6d3c4ed-7cf9-497b-b23d-f8ecb858e622",
      "name": "OpenAI Chat Model",
